{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: build debug APK",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": [":app:assembleDebug", "--console=plain"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Android: install debug APK",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": [":app:installDebug", "--console=plain"],
      "problemMatcher": []
    },
    {
      "label": "Android: launch app",
      "type": "shell",
      "command": "adb",
      "args": [
        "shell",
        "am",
        "start",
        "-n",
        "dev.fabuloso.slider/.MainActivity"
      ],
      "dependsOn": "Android: install debug APK",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
